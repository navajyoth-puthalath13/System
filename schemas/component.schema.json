{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://system-three-rouge.vercel.app/schemas/component.schema.json",
  "title": "Component metadata",
  "description": "Machine-readable metadata for a component, stored as components/<name>/schema.json. Populated only with facts that exist in the implementation and documentation.",
  "type": "object",
  "required": ["name", "type"],
  "properties": {
    "$schema": { "type": "string" },
    "name": { "type": "string" },
    "type": { "const": "component" },
    "category": { "type": "string", "description": "e.g. actions, inputs, feedback, layout." },
    "description": { "type": "string" },
    "variants": { "type": "array", "items": { "type": "string" } },
    "sizes": { "type": "array", "items": { "type": "string" } },
    "states": { "type": "array", "items": { "type": "string" } },
    "modes": { "type": "array", "items": { "type": "string" } },
    "tokens": {
      "type": "object",
      "description": "Semantic token roles the component consumes, grouped by role family.",
      "additionalProperties": { "type": "array", "items": { "type": "string" } }
    },
    "accessibility": { "type": "object" },
    "localization": { "type": "object" },
    "usage": { "type": "object" },
    "implementation": {
      "type": "object",
      "properties": {
        "file": { "type": "string" },
        "framework": { "type": "string" },
        "styling": { "type": "string" },
        "dependencies": { "type": "array", "items": { "type": "string" } },
        "registryDependencies": { "type": "array", "items": { "type": "string" } }
      }
    },
    "documentation": { "type": "string" },
    "relatedComponents": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": false
}
