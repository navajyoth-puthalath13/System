{
  "name": "design-system",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A component library + token registry, structured like Care UI (React 19 + TypeScript + Tailwind v4 + shadcn registry).",
  "scripts": {
    "tokens": "node scripts/build-tokens.mjs",
    "docs": "node scripts/build-docs.mjs",
    "validate": "node scripts/validate.mjs",
    "registry": "node scripts/generate-registry.mjs",
    "registry:shadcn:generate": "tsx scripts/generate-registry.ts",
    "registry:shadcn:check": "tsx scripts/check-registry.ts",
    "registry:shadcn:validate": "tsx scripts/validate-registry-dependencies.ts",
    "registry:shadcn": "npm run tokens && npm run registry:shadcn:check && npm run registry:shadcn:validate && npm run registry:shadcn:generate",
    "build": "npm run validate && npm run docs && npm run registry && npm run registry:shadcn",
    "serve": "node scripts/serve.mjs",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "chromatic": "chromatic",
    "chromatic": "npx chromatic --project-token=chpt_c94833168fc77bb"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.42.0",
    "lucide-static": "^1.42.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.2"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.6.1",
    "@storybook/addon-docs": "^10.6.1",
    "@storybook/react-vite": "^10.6.1",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.2.0",
    "chromatic": "^18.10.2",
    "fast-glob": "^3.3.3",
    "postcss": "^8.5.1",
    "shadcn": "^2.4.0",
    "storybook": "^10.6.1",
    "storybook-addon-pseudo-states": "^10.6.1",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^7.3.6"
  }
}
